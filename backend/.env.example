# Varuna Netra backend environment template
# Copy to backend/.env for local development.
# NEVER commit real secrets.

# Core application
APP_ENV=development
DEMO_MODE=false

# MongoDB
MONGO_URL=mongodb://localhost:27017
DB_NAME=varuna_netra

# Authentication
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# CORS / frontend
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
# CORS_ORIGIN_REGEX=

# AISStream (optional for live AIS)
AISSTREAM_API_KEY=
# Optional comma-separated key pool
AISSTREAM_API_KEYS=
AIS_INGEST_ENABLED=false

# Email via Resend (optional)
RESEND_API_KEY=
SENDER_EMAIL=onboarding@resend.dev

# Google sign-in (optional; deployment-specific)
GOOGLE_AUTH_ENABLED=false

# Object-storage integration used by the current deployment (optional)
EMERGENT_LLM_KEY=
INTEGRATION_PROXY_URL=

# Optional legacy/demo staff seeds; do not set in production unless intentionally running DEMO_MODE
DEMO_SUPERVISOR_EMAIL=
DEMO_SUPERVISOR_PASSWORD=
DEMO_ANALYST_EMAIL=
DEMO_ANALYST_PASSWORD=
